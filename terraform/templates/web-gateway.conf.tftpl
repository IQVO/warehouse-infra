# The Nginx web gateway: the fleet's ONLY host-facing frontend entrypoint.
#
# Generated by terraform/frontends.tf -- edit the template, never the rendered
# ConfigMap.
#
# THE RULE THIS FILE EXISTS TO ENFORCE: this gateway serves frontend bytes and
# nothing else. There is deliberately NO `location /api`, no Kong upstream, and
# no backend Service upstream anywhere below. APIs reach the browser on their
# own host port via Kong, which in turn never serves HTML/JS/CSS. The two edges
# are independent and neither proxies to the other -- see ADR-0005.
#
# scripts/test-exposure-policy.sh asserts exactly that, so a well-meaning
# "just proxy /api through here to avoid CORS" edit will fail the policy test
# rather than silently collapsing the separation.

worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  # Log the upstream actually chosen: this is what the policy test greps to
  # prove no API request was ever served here.
  log_format gateway '$remote_addr "$request" $status '
                     'upstream=$upstream_addr rt=$request_time';
  access_log /dev/stdout gateway;

  sendfile on;
  keepalive_timeout 65;

  # nginx-unprivileged cannot write to /var/*; keep every temp path in /tmp.
  client_body_temp_path /tmp/client_body;
  proxy_temp_path       /tmp/proxy;
  fastcgi_temp_path     /tmp/fastcgi;
  uwsgi_temp_path       /tmp/uwsgi;
  scgi_temp_path        /tmp/scgi;

  # kube-dns, so each frontend Service name resolves at REQUEST time rather
  # than being cached forever at startup. Without this, nginx resolves every
  # upstream once at boot and a redeployed frontend pod (new ClusterIP) keeps
  # 502-ing until the gateway itself restarts.
  resolver ${dns_resolver} valid=10s ipv6=off;

  server {
    listen ${listen_port};
    server_name _;

    # This gateway's own liveness, terminating here. Never proxied.
    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

%{ for remote in remotes ~}
    # ---- ${remote.context} (${remote.remote_name}) ----
    # Strip the public /mfes/${remote.context} prefix so the remote's own nginx
    # sees root-relative paths (/remoteEntry.js, /assets/...). The built bundle
    # still emits the prefixed URLs because its Vite base is /mfes/${remote.context}/,
    # which is what keeps each remote's chunks in their own namespace.
    location ^~ /mfes/${remote.context}/ {
      set $upstream_${remote.upstream_var} ${remote.service_host};
      rewrite ^/mfes/${remote.context}/(.*)$ /$1 break;
      proxy_pass http://$upstream_${remote.upstream_var}:${remote.service_port};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

%{ endfor ~}
    # ---- the EventCatalog (ecosystem) ----
    # Built with Astro base "/catalog/", so every asset and internal link it
    # emits already carries the prefix: plain proxying, no rewrite. Like the
    # MFE remotes, its own nginx does the byte serving; this is bytes only.
    location = /catalog {
      return 301 /catalog/;
    }

    location ^~ /catalog/ {
      set $upstream_ecosystem ${ecosystem_service_host};
      # Strip the public /catalog/ prefix: the catalog's Astro base prefixes
      # every emitted URL, but the files live at the dist root -- same
      # strip-and-serve shape as the /mfes/<context>/ remotes above.
      rewrite ^/catalog/(.*)$ /$1 break;
      proxy_pass http://$upstream_ecosystem:${ecosystem_service_port};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- the console shell ----
    # Last, and a prefix match on "/", so every more specific /mfes/<context>/
    # location above wins. The shell's own nginx applies the SPA fallback, so a
    # client-side route such as /order-management returns the shell rather than
    # a 404 -- that fallback is deliberately NOT duplicated here.
    location / {
      set $upstream_console ${console_service_host};
      proxy_pass http://$upstream_console:${console_service_port};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

%{ if storefront_enabled ~}
  # ---- the shopper storefront (storefront-web, SSR) ----
  # Host-based, never a path prefix: the console owns / on the default
  # server, and an SSR app emits absolute paths that a prefix would break.
  # Browsers resolve *.localhost to 127.0.0.1; curl needs --resolve or a
  # Host header. The SSR server reaches the BFF pod-to-pod (BFF_URL), so
  # this block proxies exactly one Service -- still frontend bytes only.
  server {
    listen ${listen_port};
    server_name ${storefront_host};

    location / {
      set $upstream_storefront ${storefront_service_host};
      proxy_pass http://$upstream_storefront:${storefront_service_port};
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
%{ endif ~}
}
