-- ---------------------------------------------------------------------------
-- Rendered by Terraform from templates/init-databases.sql.tftpl and mounted
-- into the PostgreSQL primary via `primary.initdb.scripts`.
--
-- Bitnami runs everything in /docker-entrypoint-initdb.d exactly once, on a
-- first boot against an empty data directory, as the postgres superuser and
-- connected to the `postgres` database. psql runs in autocommit, so
-- CREATE DATABASE is legal here.
--
-- One release, four logical databases, four least-privilege owners: each role
-- owns exactly its own database and cannot connect to any other. Since
-- PostgreSQL 15 the `public` schema is owned by pg_database_owner, so the
-- database owner gets full DDL rights on it without an extra GRANT.
-- ---------------------------------------------------------------------------
%{ for name, svc in services ~}

-- ${name}
CREATE ROLE ${svc.user} WITH LOGIN PASSWORD '${svc.password}';
CREATE DATABASE ${svc.db} WITH OWNER ${svc.user} ENCODING 'UTF8';
-- Strip the implicit PUBLIC grant so the other three roles cannot connect.
REVOKE ALL ON DATABASE ${svc.db} FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE ${svc.db} TO ${svc.user};
%{ endfor ~}

-- ---------------------------------------------------------------------------
-- Analytics data-mesh (ADR-0010 in each service repo): one extra database +
-- role per analytics-enabled service, same least-privilege pattern as the
-- OLTP databases above. This role is used as BOTH the projector's
-- (read-write) and reports' (currently same-role) connection today -- see
-- terraform/locals.tf's analytics_database_urls comment on the promotion
-- path to a distinct read-only reports role.
-- ---------------------------------------------------------------------------
%{ for name, svc in analytics_services ~}

-- ${name} (analytics)
CREATE ROLE ${svc.user} WITH LOGIN PASSWORD '${svc.password}';
CREATE DATABASE ${svc.db} WITH OWNER ${svc.user} ENCODING 'UTF8';
REVOKE ALL ON DATABASE ${svc.db} FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE ${svc.db} TO ${svc.user};
%{ endfor ~}
